{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2015",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "outDir": "./dist"
  },
  "include": ["./src/**/*.ts", "./examples/**/*.ts", "./tests/**/*.ts"],
  "exclude": ["./node_modules", "./dist"]
}
