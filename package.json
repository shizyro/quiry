{
  "name": "quiry",
  "version": "0.1.3",
  "description": "Transparent, type-safe IPC for Node worker threads and child processes.",
  "keywords": ["ipc", "worker", "proxy"],
  "author": {
    "name": "Shizuka Yashiro",
    "email": "shizuka.yashiro@gmail.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/shizyro/quiry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shizyro/quiry.git"
  },
  "bugs": {
    "url": "https://github.com/shizyro/quiry/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "bunchee --sourcemap --target es2015",
    "example": "bun examples/basic/index.ts",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bunchee": "^6.10.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "nanoid": "^5.1.9"
  }
}
