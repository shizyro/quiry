  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shizyro/quiry.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^25.6.0",
    "bunchee": "^6.10.0",
    "husky": "^9.1.7",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bugs": {
    "url": "https://github.com/shizyro/quiry/issues"
  },
  "description": "Transparent, type-safe IPC for Node worker threads and child processes.",
  "engines": {
    "node": ">=18.17.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/shizyro/quiry#readme",
  "keywords": [
    "ipc",
    "worker",
    "proxy"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "bunchee --sourcemap --target es2015",
    "test": "vitest",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "fmt": "biome format --write",
    "prepare": "husky"
  },
  "sideEffects": false,
  "type": "module"
}
